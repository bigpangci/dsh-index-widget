{
  "name": "dsh-index-widget",
  "version": "0.1.0",
  "private": true,
  "description": "A-share market ticker for the DeepSeek Harness Web UI: a scrolling strip in the session header that opens a full quote dialog",
  "license": "MIT",
  "author": "bigpangci",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigpangci/dsh-index-widget.git"
  },
  "homepage": "https://github.com/bigpangci/dsh-index-widget#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "stock",
    "a-share",
    "ticker"
  ],
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
